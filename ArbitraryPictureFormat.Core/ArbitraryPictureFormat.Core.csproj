<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net9.0;net9.0-windows</TargetFrameworks>
    <RootNamespace>ArbitraryPictureFormat</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- NuGet package metadata -->
    <PackageId>ArbitraryPictureFormat</PackageId>
    <Version>2.0.1</Version>
    <Authors>sbarisic</Authors>
    <Description>APF (Arbitrary Picture Format) — a lossless image format with 6 encoding strategies, multi-image support, per-image metadata, and a microcontroller-friendly decoder. Encode and decode APF v1.0/v1.1/v2.0 files.</Description>
    <PackageLicenseExpression>Unlicense</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/sbarisic/ArbitraryPictureFormat</PackageProjectUrl>
    <RepositoryUrl>https://github.com/sbarisic/ArbitraryPictureFormat.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>image;format;lossless;compression;apf;codec;encoder;decoder</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0-windows'">
    <PackageReference Include="System.Drawing.Common" Version="9.0.*" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>ArbitraryPictureFormat.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
